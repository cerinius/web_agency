# Public canonical URL used for metadata, sitemap, and robots.
NEXT_PUBLIC_SITE_URL=https://example.com

# Recommended for Vercel while the worker remains private and local.
# This is read only on the server; never prefix it with NEXT_PUBLIC_.
DISCORD_WEBHOOK_URL=

# Optional future route: use these only when the worker has a secured public HTTPS endpoint.
# A localhost or Docker URL cannot be reached by Vercel.
AGENCY_INTAKE_WEBHOOK_URL=
INBOUND_WEBHOOK_SECRET=
